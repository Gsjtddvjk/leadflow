    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nreturn [{ json: { success: true, name: data.name, account_status: data.account_status, currency: data.currency } }];"
      },
      "id": "format-test",
      "name": "Format Test",
      "type": "n8n-nodes-base.code",
