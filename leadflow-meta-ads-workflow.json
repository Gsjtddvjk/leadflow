            { "name": "fields", "value": "id,name,status,objective,daily_budget" },
            { "name": "limit", "value": "50" },
            { "name": "access_token", "value": "={{ $json.accessToken }}" }
          ]
        },
        "options": {}
      },
      "id": "get-campaigns",
      "name": "Get Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 700]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nreturn [{ json: { success: true, campaigns: data.data || [] } }];"
      },
      "id": "format-campaigns",
      "name": "Format Campaigns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 700]
    },
    {
